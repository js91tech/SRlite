# Server
PORT=3001
NODE_ENV=development

# Live leads — get a free key at https://511ga.org/developers/doc
GA511_API_KEY=

# Production / Railway: set NODE_ENV=production (auto-clears demo leads on deploy)
# Optional explicit flag (also clears demo leads on startup):
# LIVE_MODE=true

# Dev only: force demo seed data even when GA511_API_KEY is set
# SEED_DEMO_DATA=true
